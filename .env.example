# --- Server ---
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL="postgresql://roisystem:roisystem@localhost:5432/roisystem?schema=public"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Dashboard auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Field-level encryption for stored GHL tokens ---
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="change-me-32-bytes-base64"

# --- GoHighLevel (Fase 6: Private Integration Token, no Marketplace app) ---
# No app-level credentials here at all — each client connects a sub-account
# by pasting its own GHL Private Integration Token via POST /api/locations
# (encrypted at rest with TOKEN_ENCRYPTION_KEY). They generate it from their
# own GHL sub-account: Settings > Private Integrations. Only the shared API
# base URL lives here.
GHL_API_BASE_URL="https://services.leadconnectorhq.com"

# --- Webhook signature verification (best-effort, see src/modules/ghl/webhooks.ts) ---
GHL_WEBHOOK_SECRET=""

# --- Fathom (Fase 3) ---
# No API key here — each closer pastes their own personal Fathom API key via
# POST /api/fathom/connection (encrypted at rest with TOKEN_ENCRYPTION_KEY).
# This is only the shared API base URL. Verify against Fathom's current docs.
FATHOM_API_BASE_URL="https://api.fathom.ai/external/v1"

# --- Meta Ads (Fase 3.5) ---
# No credentials here — each Location connects its own ad account id + a
# long-lived System User access token via POST /api/meta-ads/connection
# (encrypted at rest). Base URL confirmed against
# developers.facebook.com/docs/marketing-api/insights.
META_ADS_API_BASE_URL="https://graph.facebook.com/v21.0"

# --- Hotmart (Fase 3.5) ---
# No credentials here — each Location connects its own client_id/client_secret
# (from Hotmart's "Ferramentas > Credenciais de desenvolvedor") via
# POST /api/hotmart/connection (encrypted at rest). URLs confirmed against
# developers.hotmart.com (App Authentication + Sales History docs).
HOTMART_OAUTH_URL="https://api-sec-vlc.hotmart.com/security/oauth/token"
HOTMART_API_BASE_URL="https://developers.hotmart.com/payments/api/v1"
